# =================================
# SECURITY
# =================================
SESSION_SECRET=your_strong_secret_here
JWT_SECRET=your_jwt_secret_here
ADMIN_DEFAULT_PASSWORD=change_this_admin_password

# =================================
# DATABASE
# =================================
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# =================================
# SERVER
# =================================
SERVER_PORT=3001
SERVER_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
FORCE_SECURE_COOKIE=false
TZ=Asia/Jakarta
ALLOWED_ORIGINS=http://localhost:3001,https://wapi.jasaedukasi.com,http://wapi.jasaedukasi.com

# =================================
# LIMITS
# =================================
DAILY_MESSAGE_LIMIT_BASIC=250
DAILY_MESSAGE_LIMIT_STANDARD=500
DAILY_MESSAGE_LIMIT_PRO=1000
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_API_MAX=120
RATE_LIMIT_DASHBOARD_MAX=240
AUTH_LOCKOUT_MAX=5
AUTH_LOCKOUT_MINUTES=15
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb

# =================================
# BRANDING
# =================================
SUPPORT_EMAIL=support@yourcompany.com
PRICING_URL=https://yourdomain.com/#pricing
APP_NAME=Your App Name

# =================================
# DUITKU
# =================================
DUITKU_MERCHANT_CODE=your_duitku_merchant_code
DUITKU_MERCHANT_KEY=your_duitku_merchant_key
DUITKU_CALLBACK_URL=http://localhost:3001/callback
DUITKU_RETURN_URL=http://localhost:3001/success
DUITKU_ENVIRONMENT=sandbox
DUITKU_EXPIRY_MINUTES=10

# =================================
# FEATURES
# =================================
FEATURE_OPT_IN=0
CRON_OPERATIONAL_24H=0
AUTO_OPT_IN_INVITATION=0
MAX_AUTO_INVITES_PER_BULK=3
OPT_IN_REMINDER_BATCH_LIMIT=50
WA_SYNC_HISTORY_ON_RECONNECT=1
WA_SYNC_FULL_HISTORY=0

# =================================
# WHATSAPP ANTI-BAN (Baileys rc14)
# =================================
# Minimum gap between two outbound messages on the same device (ms)
WA_SEND_MIN_GAP_MS=2500
# Random extra delay added on top of the min gap (ms)
WA_SEND_JITTER_MS=2000
# Baileys logger level: fatal | error | warn | info | debug | trace
WA_LOG_LEVEL=warn
# Country code used in the registration payload
WA_COUNTRY_CODE=62
