# =================================
# FEATURES
# =================================
FEATURE_OPT_IN=0
CRON_OPERATIONAL_24H=true
AUTO_OPT_IN_INVITATION=false
MAX_AUTO_INVITES_PER_BULK=3
OPT_IN_REMINDER_BATCH_LIMIT=50
WA_SYNC_HISTORY_ON_RECONNECT=1
WA_SYNC_FULL_HISTORY=0

# =================================
# WHATSAPP ANTI-BAN (Baileys rc14)
# =================================
# Minimum gap between two outbound messages on the same device (ms)
WA_SEND_MIN_GAP_MS=2500
# Random extra delay added on top of the min gap (ms)
WA_SEND_JITTER_MS=2000
# Baileys logger level: fatal | error | warn | info | debug | trace
WA_LOG_LEVEL=warn
# Country code used in the registration payload
WA_COUNTRY_CODE=62

# =================================
# OPTIONAL FLAGS
# =================================
# DISABLE_CRON=false
# MAINTENANCE_MODE=false


